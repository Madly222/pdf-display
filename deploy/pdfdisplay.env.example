# /etc/pdfdisplay/pdfdisplay.env  (chmod 600, owner root)

# Public address of this service; used in generated links and iframe code.
PD_PUBLIC_URL=https://pdf.example.com

# Shared key for POST /api/render (Odoo integration). Generate with:
#   head -c 32 /dev/urandom | base64 | tr -d '=+/'
# Put the same value into the Odoo system parameter pdfdisplay_preview.secret.
PD_RENDER_TOKEN=change-me

# Space-separated origins allowed to embed the Odoo preview in an iframe.
PD_ODOO_ORIGINS=https://odoo.example.com
